STUDIO_DATA_DIR=/workspace/data
# Local single-user use defaults to loopback. Set a token before exposing to a network.
# STUDIO_TOKEN=replace-with-a-long-random-secret
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514
# STUDIO_ENABLE_RESEARCH=1
# STUDIO_MAX_UPLOAD_MB=25
# STUDIO_CHROMIUM=/usr/bin/chromium
# Enable only for a trusted egress proxy with private-destination/DNS protections:
# STUDIO_TRUST_EGRESS_PROXY=1
